# ── Client (exposed to the browser, prefixed with VITE_) ─────────────────────
# Base URL for the Render backend API used by the admin panel (auth, categories,
# dishes, uploads). Leave unset to go through the same-origin /api proxy.
# VITE_API_URL=https://staropub-menu.onrender.com/api

# Optional Firebase overrides (defaults live in src/admin/firebase.js).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# ── Server (Vercel functions only, never exposed to the browser) ─────────────
# Upstream backend API. Defaults to https://staropub-menu.onrender.com/api.
# BACKEND_API_URL=https://staropub-menu.onrender.com/api

# Token the /api/calls and /api/reviews functions send when writing guest
# calls/reviews to the backend settings document. Required if the backend's
# PUT /settings demands authentication (recommended).
# BACKEND_SERVICE_TOKEN=
