{
  "functions": {
    "api/menu.js": {
      "maxDuration": 60
    },
    "api/catalog.js": {
      "maxDuration": 60
    },
    "api/settings.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/Images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|webp|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/menu",
      "destination": "/api/menu"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/catalog"
    },
    {
      "source": "/api/calls",
      "destination": "/api/calls"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews"
    },
    {
      "source": "/api/dishes/:path*",
      "destination": "https://staropub-menu.onrender.com/api/dishes/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://staropub-menu.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
