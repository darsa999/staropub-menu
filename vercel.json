{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/menu",
      "destination": "/api/menu"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/catalog"
    },
    {
      "source": "/api/:path*",
      "destination": "https://staropub-menu.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
